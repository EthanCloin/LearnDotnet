@model IEnumerable<OrderModel>
    @{
    Layout = null;
    }
    <div>
        <div>
            @foreach (var order in Model)
            {
            <details style="background-color: #64b5f6">
                <summary hx-get="/Main/Products?orderID=@order.OrderID" hx-swap="innerHTML" hx-target="next div"
                    hx-trigger="click">
                    Order @order.OrderID - @order.Status
                </summary>
                <div>content</div>
            </details>
            }
        </div>
    </div>
